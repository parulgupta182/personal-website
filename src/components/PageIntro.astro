---
import { withBase } from '../lib/utils';
interface Props { eyebrow: string; title: string; lede?: string }
const { eyebrow, title, lede } = Astro.props;
---
<section class="page-intro" id="top" aria-labelledby="page-title">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={withBase('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span>
    </nav>
    <p class="eyebrow"><span class="eyebrow__num">{eyebrow}</span><span class="eyebrow__rule" aria-hidden="true"></span></p>
    <h1 id="page-title">{title}</h1>
    {lede && <p class="lede page-intro__lede">{lede}</p>}
    <slot />
  </div>
</section>

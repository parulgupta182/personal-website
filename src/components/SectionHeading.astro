---
interface Props { index: string; title: string; id: string; lede?: string }
const { index, title, id, lede } = Astro.props;
---
<div class="section-heading">
  <p class="eyebrow"><span class="eyebrow__num">{index}</span><span class="eyebrow__rule" aria-hidden="true"></span></p>
  <h2 id={`${id}-title`}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</div>

---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/utils';
---
<Base title="Page not found — Parul Gupta">
  <main id="main" class="notfound">
    <div class="container">
      <p class="eyebrow"><span class="eyebrow__num">404</span><span class="eyebrow__rule" aria-hidden="true"></span></p>
      <h1>Page not found</h1>
      <p class="lede">The page you were looking for does not exist or has moved.</p>
      <p><a class="btn btn--primary" href={withBase('/')}>Go to homepage</a></p>
    </div>
  </main>
</Base>
